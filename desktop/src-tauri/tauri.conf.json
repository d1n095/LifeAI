{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MainAI",
  "version": "0.1.0",
  "identifier": "ai.mainai.client",
  "build": {
    "beforeDevCommand": "npm run export:frontend",
    "beforeBuildCommand": "npm run export:frontend",
    "frontendDist": "../.app-build/out",
    "devUrl": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MainAI",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' mainaiapi: ipc: http://ipc.localhost; img-src 'self' data: blob: mainaiapi:; media-src 'self' blob: mainaiapi:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "MainAI",
    "longDescription": "MainAI — Founder cross-platform client for chat, tasks, agents and approvals."
  }
}
