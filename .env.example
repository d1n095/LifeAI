# Kopiera denna fil till .env och fyll i det du faktiskt använder.
# Endast leverantörer med ifylld nyckel går att aktivera i adminpanelen.

ENVIRONMENT=development
# Signerar JWT-tokens — byt till ett långt slumpmässigt värde i produktion,
# t.ex. med: openssl rand -hex 32
SECRET_KEY=change-me

# Skapar automatiskt det enda grundarkontot (MainAI är Founder-only, ingen publik
# registrering finns — se backend/app/routers/auth.py) vid första uppstart, om det inte
# redan finns.
FOUNDER_EMAIL=founder@lifeos.local
FOUNDER_PASSWORD=change-me

# Lösenord för den begränsade databasrollen backend faktiskt kör frågor som (inte
# superusern) — det är detta som gör Row-Level Security verkningsfull. Byt i produktion.
# På hanterade Postgres-tjänster utan init-skriptstöd (t.ex. Render): sätt bara denna
# variabel (inte APP_DATABASE_URL) — backend/docker-entrypoint.sh skapar rollen och räknar
# ut hela APP_DATABASE_URL åt dig, se docs/RENDER_DEPLOY.md.
MAINAI_APP_PASSWORD=change-me

# Aktiv leverantör/modell som standard innan något ställs om i adminpanelen
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_PROVIDER=openai
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# API-nycklar — lämna tomt för leverantörer du inte använder
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Endast relevant om du kör "local-llm"-profilen (Ollama)
OLLAMA_BASE_URL=http://ollama:11434

# Ordning AI-motorn faller tillbaka i om aktiv chat-leverantör felar
CHAT_FALLBACK_ORDER=openai,anthropic,gemini

# Kommaseparerad, explicit lista över tillåtna frontend-origins (aldrig "*" — se
# docs/AUTH_THREAT_MODEL.md). Lägg till din faktiska produktions-URL, t.ex.:
# FRONTEND_ORIGINS=http://localhost:3000,https://life-ai-seven.vercel.app
FRONTEND_ORIGINS=http://localhost:3000

# Cookie-inställningar för sessionen (access/refresh/csrf). Secure fungerar utan HTTPS på
# localhost/127.0.0.1 (webbläsarundantag) — samma säkra inställningar i dev och produktion.
# SameSite=none krävs eftersom frontend och backend är olika origins.
COOKIE_SECURE=true
COOKIE_SAMESITE=none
# COOKIE_DOMAIN=.exempel.se   # sätt bara om frontend/backend delar registrerbar domän

REFRESH_TOKEN_EXPIRE_DAYS=14

# Bas-URL som läggs in i verifierings-/återställningslänkar i mail — den publika adressen
# till frontend, inte en CORS-inställning (se FRONTEND_ORIGINS ovan).
PUBLIC_APP_URL=http://localhost:3000

# SMTP för konto-mail (registrering, verifiering, lösenordsåterställning). Lämnas SMTP_HOST
# tomt skickas inget mail på riktigt (mailet skrivs ALDRIG till backend-loggen — den kan
# innehålla en engångstoken, se backend/app/email.py). För lokal utveckling: kör
# `docker compose --profile dev-mail up mailhog` och peka SMTP_HOST mot den istället.
# SMTP_HOST=smtp.exempel.se
#
# Två ömsesidigt uteslutande anslutningslägen (exakt en av dessa ska vara true — se
# app/email.py och app/main.py:_check_smtp_mode):
#   SMTP_USE_TLS=true, SMTP_USE_SSL=false, SMTP_PORT=587  — STARTTLS (vanligast)
#   SMTP_USE_TLS=false, SMTP_USE_SSL=true, SMTP_PORT=465  — implicit TLS/SSL (t.ex. Strato:
#                                                            smtp.strato.com:465)
SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=no-reply@lifeos.local
SMTP_FROM_NAME=MainAI / Life OS
# Endast lokal utveckling, ALDRIG i produktion: skriver ett oskickat mail (inkl. dess token)
# som en textfil i denna katalog istället för att bara tystas ner. Lämna tom/ur kommentar i
# produktion — sätt SMTP_HOST eller mailhog-profilen ovan istället.
# DEV_MAIL_OUTBOX_DIR=/tmp/mainai-dev-mail

# Delad lagring för rate limiting (slowapi) — krävs för mer än en backend-instans, se
# docs/OPERATIONS.md. Tom = processlokal in-memory-räkning (bara korrekt med exakt en
# instans). docker-compose.yml sätter detta mot redis-tjänsten som standard.
REDIS_URL=redis://redis:6379/0

# Hur länge utgångna/återkallade/använda auth-tokens behålls innan städjobbet (app/cleanup.py)
# tar bort dem permanent — se docs/OPERATIONS.md för retention-motivering.
TOKEN_CLEANUP_RETENTION_DAYS=30
ENABLE_SCHEDULED_CLEANUP=true
CLEANUP_INTERVAL_HOURS=24
