# Template for the VPS secrets file. This file itself is committed (no real secrets in it) —
# the REAL file is never committed. See docs/STRATO_VPS_DEPLOY.md's "Hemligheter" section for
# the exact steps, summarized here:
#
#   1. Copy this file to /etc/lifeai/lifeai.env on the VPS itself (never in the git checkout).
#   2. Fill in every value below with the real secret/URL.
#   3. chown root:root /etc/lifeai/lifeai.env && chmod 600 /etc/lifeai/lifeai.env
#   4. Add /etc/lifeai/ to the VPS's own backup routine (see docs/STRATO_VPS_DEPLOY.md's
#      backup section) — it is the ONLY stateful thing on the VPS itself, since Postgres and
#      Redis both live externally (Supabase, Upstash).
#
# docker-compose.vps.yml's backend/frontend services read this file via
# `env_file: [${LIFEAI_ENV_FILE:-/etc/lifeai/lifeai.env}]` — LIFEAI_ENV_FILE is only ever
# overridden by CI (docker-compose.vps.ci.yml), never on the real server.

# ---- Generated secrets (openssl rand -hex 32, one value each, never reused from Render) ----
SECRET_KEY=
MAINAI_APP_PASSWORD=

# ---- Founder account (same single fixed account as Render — see backend/app/founder.py) ----
FOUNDER_EMAIL=
FOUNDER_PASSWORD=

# ---- Database — Supabase Free, Session pooler connection (Supavisor, port 5432) — NOT
# Direct (IPv6-only) and NOT Transaction pooler (port 6543, no session-level DDL). Same
# connection string format already used for Render — see docs/RENDER_DEPLOY.md's
# "Databasrollerna" section, unchanged here. ----
DATABASE_URL=
APP_DATABASE_URL=

# ---- Redis — Upstash Free, same instance class already used for Render (a fresh Upstash
# database is fine too; nothing here is Render-specific). ----
REDIS_URL=

# ---- SMTP — required in production (ENVIRONMENT=production below), see
# backend/app/main.py's _check_smtp_configured(). ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Set exactly one of these to true, never both — see backend/app/config.py.
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ---- AI provider keys — fill in at least one ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# ---- Public-facing values — the VPS's own domain, not Render's ----
ENVIRONMENT=production
FRONTEND_ORIGINS=https://DOMAIN-HÄR
PUBLIC_APP_URL=https://DOMAIN-HÄR
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# ---- Caddy's own domain (see Caddyfile) — the same value as above, without the scheme ----
DOMAIN=DOMAIN-HÄR

# ---- Digest-pinned images — filled in by whoever performs the manual deploy, from the
# digest GitHub Actions printed after building (.github/workflows/build-images.yml). Never a
# mutable tag like `:latest` — see docs/STRATO_VPS_DEPLOY.md's "Första manuella deploy". ----
BACKEND_IMAGE=ghcr.io/d1n095/lifeai-backend@sha256:
FRONTEND_IMAGE=ghcr.io/d1n095/lifeai-frontend@sha256:
