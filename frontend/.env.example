# Leave both unset for the default, same-origin setup: the browser calls this server's own
# /api/* (app/api/[...path]/route.ts), which forwards to the backend server-side. See that
# file and docs/RENDER_DEPLOY.md.

# Server-only — where THIS server reaches the backend from. Never sent to the browser.
INTERNAL_API_URL=http://localhost:8000

# Escape hatch only: set this to make the BROWSER call the backend directly, cross-origin,
# instead of going through the proxy above (e.g. a deployment that can't run the proxy
# server-side). Inlined into the client bundle at build time — see frontend/Dockerfile.
# NEXT_PUBLIC_API_URL=http://localhost:8000
