# Staging — same structure as the production Caddyfile (reused deliberately, not
# reinvented), with one addition: `basic_auth` gates the entire site before any request ever
# reaches the app. This candidate has not been through independent security review yet (see
# docs/STAGING_DEPLOYMENT.md), so staging gets a second, network-level gate in front of the
# app's own founder login — defense in depth, not a replacement for it.
#
# Listens on :8443/:8080 (via STAGING_DOMAIN, e.g. "staging.exempel.se:8443" or a bare
# ":8080" for a plain-HTTP CI/local check) — never 443/80, so this never collides with a
# production Caddy on the same host. See docker-compose.staging.yml's own comment on why that
# port choice is deliberate, not just a default.
{$STAGING_DOMAIN} {
	encode zstd gzip

	basic_auth {
		{$STAGING_BASIC_AUTH_USER} {$STAGING_BASIC_AUTH_HASH}
	}

	request_body {
		max_size 30MB
	}

	reverse_proxy frontend:3000

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
